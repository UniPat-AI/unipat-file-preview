{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unipat.dev/file-preview/schemas/preview-state.v1.json",
  "title": "PreviewState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preview_id",
    "file_ref",
    "profile_id",
    "generation",
    "execution_state",
    "availability",
    "stage",
    "progress",
    "revision",
    "published_revision",
    "is_previous_result",
    "permissions",
    "warnings",
    "error",
    "retry_after_ms"
  ],
  "properties": {
    "preview_id": { "type": "string", "minLength": 1 },
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_key", "version"],
      "properties": {
        "resource_key": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "profile_id": { "type": "string", "minLength": 1 },
    "generation": { "type": "integer", "minimum": 0 },
    "execution_state": {
      "enum": ["queued", "running", "succeeded", "failed", "cancelled"]
    },
    "availability": { "enum": ["none", "ready", "partial"] },
    "stage": {
      "enum": [
        "queued",
        "fetching",
        "inspecting",
        "converting",
        "validating",
        "publishing"
      ]
    },
    "progress": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["done", "total", "unit"],
          "properties": {
            "done": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 },
            "unit": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "revision": { "type": "integer", "minimum": 0 },
    "published_revision": {
      "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }]
    },
    "is_previous_result": { "type": "boolean" },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["download_original", "print", "copy", "retry"],
      "properties": {
        "download_original": { "type": "boolean" },
        "print": { "type": "boolean" },
        "copy": { "type": "boolean" },
        "retry": { "type": "boolean" }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/Warning" }
    },
    "error": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/ErrorPayload" }]
    },
    "retry_after_ms": {
      "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }]
    }
  },
  "$defs": {
    "Warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "scope": { "type": "string" }
      }
    },
    "ErrorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      }
    }
  }
}
