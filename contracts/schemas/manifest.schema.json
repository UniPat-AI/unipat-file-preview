{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unipat.dev/file-preview/schemas/manifest.v1.json",
  "title": "Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preview_id",
    "source_id",
    "profile_id",
    "published_revision",
    "source",
    "default_representation_id",
    "availability",
    "representations",
    "artifacts",
    "capabilities",
    "warnings"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "preview_id": { "type": "string", "minLength": 1 },
    "source_id": { "type": "string", "minLength": 1 },
    "profile_id": { "type": "string", "minLength": 1 },
    "published_revision": { "type": "integer", "minimum": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "extension", "size_bytes"],
      "properties": {
        "name": { "type": "string" },
        "extension": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "default_representation_id": { "type": "string", "minLength": 1 },
    "availability": { "enum": ["ready", "partial"] },
    "representations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Representation" }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/ArtifactDescriptor" }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["search_scope", "static_only"],
      "properties": {
        "search_scope": {
          "enum": ["none", "current_window", "current_sheet", "document"]
        },
        "static_only": { "type": "boolean" },
        "has_text_layer": { "type": "boolean" }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/Warning" }
    }
  },
  "$defs": {
    "Warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "scope": { "type": "string" }
      }
    },
    "CoverageInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "shown", "total"],
      "properties": {
        "unit": {
          "enum": ["rows", "frames", "cells", "chars", "pages"]
        },
        "shown": { "type": "integer", "minimum": 0 },
        "total": {
          "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }]
        },
        "scope": { "type": "string" }
      }
    },
    "Representation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label",
        "status",
        "completeness",
        "affects_completeness",
        "entry_artifact_id",
        "coverage",
        "warnings",
        "error"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["pdf", "table", "gallery", "html", "text", "notebook"]
        },
        "label": { "type": "string" },
        "status": { "enum": ["ready", "failed", "skipped"] },
        "completeness": { "enum": ["complete", "partial", "unknown"] },
        "affects_completeness": { "type": "boolean" },
        "entry_artifact_id": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        },
        "coverage": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/CoverageInfo" }]
        },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/Warning" }
        },
        "error": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message", "retryable"],
              "properties": {
                "code": { "type": "string" },
                "message": { "type": "string" },
                "retryable": { "type": "boolean" }
              }
            }
          ]
        }
      }
    },
    "ArtifactDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "media_type", "size_bytes", "sha256", "role"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "role": {
          "enum": ["entry", "chunk", "thumbnail", "frame", "auxiliary"]
        }
      }
    }
  }
}
